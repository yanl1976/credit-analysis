# ===== 应用 =====
PORT=3000

# ===== 数据库（MySQL 8；信创期改达梦/人大金仓 MySQL 兼容协议，同样用 mysql2 驱动）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=credit_analysis

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 渠道 API（暂无账号请留空，Connector 会自动跳过）=====
# 主力 API 二选一：企查查 或 天眼查
# QCC_API_KEY=
# QCC_API_BASE=https://api.qcc.com
# TIAN_YAN_CHA_API_KEY=
# TIAN_YAN_CHA_API_BASE=https://open.api.tianyancha.com
# 接口路径以控制台「已开通接口」为准；默认企业三要素验证(ID 1074)
# TIAN_YAN_CHA_BASEINFO_PATH=/services/open/ic/verify/2.0
# 鉴权头留空=裸 token（Authorization: <token>，官方示例写法）
# TIAN_YAN_CHA_AUTH_SCHEME=
# 公开渠道（信用中国/执行信息公开网）默认启用，无需 Key（实测两站已加验证码+WAF，自动采集不可用）

# ===== AI（OpenAI 兼容 chat/completions）=====
USE_LLM=true
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.chat/v1/chat/completions
MINIMAX_MODEL=MiniMax-M2.5-highspeed
MINIMAX_STRIP_THINKING=true
# 也可用通用变量覆盖：LLM_API_KEY / LLM_API_URL / LLM_MODEL / LLM_TIMEOUT_MS / LLM_MAX_TOKENS

# ===== 联网检索（可选，配置任一即启用；不配置则 AI 仅凭已有知识，可能过时）=====
# SEARCH_PROVIDER=tavily   # 可选 tavily / serper / bing，缺省按已配置的 Key 自动判断
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BING_SEARCH_KEY=
# SEARCH_MAX_RESULTS=6
