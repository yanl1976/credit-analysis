# ===== 应用 =====
PORT=3000

# ===== 数据库 =====
# 开发期使用 sqlite3（单机文件，零依赖）；信创生产期改为 pg 或 mysql2 并填写下方连接。
DB_CLIENT=sqlite3
# sqlite3 模式：文件路径
DB_FILENAME=./data/credit_analysis.sqlite
# pg / mysql2 模式（信创：人大金仓/达梦的兼容协议）：
# DB_CLIENT=pg
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=credit_analysis
# DB_USER=credit
# DB_PASSWORD=******

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 渠道 API（暂无账号请留空，Connector 会自动跳过）=====
# 主力 API 二选一：企查查 或 天眼查
# QCC_API_KEY=
# QCC_API_BASE=https://api.qcc.com
# TIAN_YAN_CHA_API_KEY=
# TIAN_YAN_CHA_API_BASE=https://open.tianyancha.com
# 公开渠道（信用中国/执行信息公开网）默认启用，无需 Key
