# ===== 应用 =====
PORT=3000

# ===== 数据库（MySQL 8；信创期改达梦/人大金仓 MySQL 兼容协议，同样用 mysql2 驱动）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=credit_analysis

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ===== 渠道 API（暂无账号请留空，Connector 会自动跳过）=====
# 主力 API 二选一：企查查 或 天眼查
# QCC_API_KEY=
# QCC_API_BASE=https://api.qcc.com
# TIAN_YAN_CHA_API_KEY=
# TIAN_YAN_CHA_API_BASE=https://open.tianyancha.com
# 公开渠道（信用中国/执行信息公开网）默认启用，无需 Key
